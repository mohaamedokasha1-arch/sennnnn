# ============================================================================
#  متغيرات البيئة — أكاشا سينما (لوحة التحكم)
# ============================================================================
# انسخ هذا الملف إلى .env.local وعدّل القيم حسب بيئتك.
# لا تضع .env.local في Git (موجود مسبقًا في .gitignore).
# ============================================================================

# مفتاح سري لتوقيع الجلسات (يُستخدم لتشديد ربط الكوكي بالخادم في النسخ المستقبلية).
# غيّره إلى سلسلة عشوائية طويلة في الإنتاج.
AKASHA_SESSION_SECRET=change-me-to-a-long-random-string

# لتشغيل البناء كتصدير ثابت (بدون لوحة تحكم) — مُستخدم في استضافة Vercel المجانية
# بدون Node.js runtime. اتركه مضبوطًا على 0 للوضع الكامل (مع لوحة التحكم).
AKASHA_STATIC_EXPORT=0

# NODE_ENV تضبطها بيئة الاستضافة تلقائيًا (development/production).
